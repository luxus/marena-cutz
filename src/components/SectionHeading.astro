---
interface Props {
  index?: string;
  title: string;
  class?: string;
}

const { index, title, class: className = '' } = Astro.props;
---

<div class:list={['section-heading scroll-reveal reveal-from-left', className]}>
  {
    index && (
      <p class="mb-3 text-label-caps text-secondary">
        <span class="tabular-nums tracking-[0.2em]">{index}</span>
      </p>
    )
  }
  <div class="flex items-center gap-4">
    <span class="section-accent h-0.5 w-8 shrink-0 bg-secondary" aria-hidden="true"></span>
    <h2 class="text-headline-lg uppercase">{title}</h2>
  </div>
</div>
