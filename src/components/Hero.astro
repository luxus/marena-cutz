---
import { getEntry } from 'astro:content';
import { splitHeadline } from '../lib/headline';
import BookingTrigger from './BookingTrigger.svelte';
import ReceiptIcon from './ReceiptIcon.astro';

const [homeEntry, settingsEntry] = await Promise.all([
  getEntry('home', 'home'),
  getEntry('settings', 'settings'),
]);
const c = homeEntry!.data;
const s = settingsEntry!.data;
const lines = splitHeadline(c.headline);
---

<section
  id="hero"
  class="hero relative min-h-[100svh] overflow-hidden border-b border-outline-variant"
>
  <img
    src="/images/salon-hero-new.png"
    alt={s.ogImageAlt || `${s.name} barber shop in Bülach`}
    width="1536"
    height="1024"
    class="hero-photo absolute inset-0 h-full w-full object-cover"
    fetchpriority="high"
    decoding="async"
  />
  <div class="mouse-glow absolute inset-0 pointer-events-none"></div>
  <div class="absolute inset-0 hero-overlay"></div>
  <div id="fade-ribbon-slot" class="fade-ribbon-slot" aria-hidden="true">
    <div id="fade-ribbon-fallback" class="fade-ribbon-fallback"></div>
    <canvas id="fade-ribbon" class="fade-ribbon-canvas"></canvas>
  </div>

  <div class="relative z-10 flex min-h-[100svh] flex-col">
    <div class="flex-1"></div>
    <div class="shell pb-28 md:pb-16">
      <p class="hero-text hero-text-1 mb-4 text-label-caps text-secondary md:mb-5">{c.eyebrow}</p>
      <h1 class="hero-headline">
        {
          lines.map((line, i) => (
            <span
              class:list={[
                'hero-line block',
                i % 2 === 0 ? 'hero-slide-left' : 'hero-slide-right',
                `hero-text-${i + 2}`,
              ]}
            >
              {line}
            </span>
          ))
        }
      </h1>
      <div
        class="hero-text hero-text-6 mt-8 flex flex-col gap-3 sm:max-w-none sm:flex-row sm:gap-4"
      >
        <BookingTrigger
          client:idle
          label="Termin buchen"
          showIcons={true}
          class="group btn-primary w-full justify-between px-8 py-4 sm:w-72 active:scale-[0.982]"
        />
        <a
          href="#preise"
          class="group btn-secondary w-full justify-between px-8 py-4 sm:w-72 active:scale-[0.982]"
        >
          <ReceiptIcon class="h-4 w-4" /> Preise ansehen
        </a>
      </div>
      <p class="mt-6 text-label-caps text-on-surface-variant">{s.address} · {s.zipCity}</p>
    </div>
  </div>
</section>

<script>
  import { shouldMountWebGL } from '../lib/webgl-guard';

  const hero = document.getElementById('hero');
  const slot = document.getElementById('fade-ribbon-slot');
  const canvas = document.getElementById('fade-ribbon') as HTMLCanvasElement | null;
  const fallback = document.getElementById('fade-ribbon-fallback');

  const bootRibbon = () => {
    if (!canvas || !shouldMountWebGL()) return;
    const start = () => {
      import('../lib/fade-ribbon')
        .then(({ mountFadeRibbon }) => {
          const handle = mountFadeRibbon(canvas, {
            root: slot ?? canvas,
            pointerRoot: hero ?? undefined,
          });
          if (handle.live) {
            canvas.classList.add('is-live');
            fallback?.classList.add('is-replaced');
          }
        })
        .catch(() => {
          /* CSS fade gradient stays in place. */
        });
    };
    if ('requestIdleCallback' in window) requestIdleCallback(() => start(), { timeout: 1800 });
    else setTimeout(start, 400);
  };

  if (document.readyState === 'complete') bootRibbon();
  else window.addEventListener('load', bootRibbon, { once: true });

  if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const glow = hero.querySelector<HTMLElement>('.mouse-glow');
    if (glow) {
      hero.addEventListener(
        'pointermove',
        (e) => {
          const rect = hero.getBoundingClientRect();
          glow.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          glow.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        },
        { passive: true }
      );
    }
  }
</script>
