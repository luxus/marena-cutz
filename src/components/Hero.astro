---
import { getCollection, getEntry } from 'astro:content';
import { splitHeadline } from '../lib/headline';
import BookingTrigger from './BookingTrigger.svelte';
import CrazyStage from './CrazyStage.svelte';
import ReceiptIcon from './ReceiptIcon.astro';

const [homeEntry, settingsEntry] = await Promise.all([
  getEntry('home', 'home'),
  getEntry('settings', 'settings'),
]);
const c = homeEntry!.data;
const s = settingsEntry!.data;
const barberEntries = await getCollection('barbers');
const cast = barberEntries
  .map((entry) => entry.data)
  .filter((barber) => barber.enabled !== false)
  .sort((a, b) => (a.order || 0) - (b.order || 0))
  .map((barber) => ({
    name: barber.name,
    position: barber.position,
    image: barber.image,
  }));
const lines = splitHeadline(c.headline);
const marquee = [c.eyebrow, c.headline, s.name, s.tagline, s.zipCity, s.address].filter(Boolean);
const loop = [...marquee, ...marquee];
---

<section id="hero" class="crazy-hero hero relative min-h-[100svh] overflow-hidden">
  <div class="crazy-fallback" aria-hidden="true"></div>
  <CrazyStage client:only="svelte" barbers={cast} />
  <div class="absolute inset-0 hero-overlay pointer-events-none"></div>

  <p class="crazy-rail">{s.address} · {s.zipCity}</p>

  <div class="hero-copy relative z-10 flex min-h-[100svh] flex-col">
    <div class="flex-1"></div>
    <div class="shell pb-36 md:pb-28">
      <p class="hero-text hero-text-1 mb-4 text-label-caps text-secondary md:mb-5">{c.eyebrow}</p>
      <h1 class="hero-headline">
        {
          lines.map((line, i) => (
            <span
              class:list={[
                'hero-line block',
                i % 2 === 0 ? 'hero-slide-left' : 'hero-slide-right',
                `hero-text-${i + 2}`,
              ]}
            >
              {line}
            </span>
          ))
        }
      </h1>
      <div
        class="hero-text hero-text-6 mt-8 flex flex-col gap-3 sm:max-w-none sm:flex-row sm:gap-4"
      >
        <BookingTrigger
          client:idle
          label="Termin buchen"
          showIcons={true}
          class="group btn-primary w-full justify-between px-8 py-4 sm:w-72 active:scale-[0.982]"
        />
        <a
          href="#preise"
          class="group btn-secondary w-full justify-between px-8 py-4 sm:w-72 active:scale-[0.982]"
        >
          <ReceiptIcon class="h-4 w-4" /> Preise ansehen
        </a>
      </div>
      <nav class="crazy-cast" aria-label="Barbers">
        {
          cast.map((barber) => (
            <a href={`#barber-${barber.name.toLowerCase()}`}>
              {barber.name}
              <span>{barber.position}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <div class="cutz-marquee" aria-hidden="true">
    <div class="cutz-marquee__track">
      {loop.map((item) => <span>{item}</span>)}
    </div>
  </div>
</section>
