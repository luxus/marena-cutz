---
import { getCollection, getEntry } from 'astro:content';
import MailIcon from './MailIcon.astro';
import OpeningHours from './OpeningHours.svelte';
import PhoneIcon from './PhoneIcon.astro';
import SectionHeading from './SectionHeading.astro';

const [aboutEntry, settingsEntry, barbersEntries] = await Promise.all([
  getEntry('about', 'about'),
  getEntry('settings', 'settings'),
  getCollection('barbers'),
]);
const about = aboutEntry!.data;
const s = settingsEntry!.data;

const barbers = barbersEntries
  .map((e) => e.data)
  .filter((b) => b.enabled !== false)
  .sort((a, b) => (a.order || 0) - (b.order || 0));
---

<section class="about-barbers relative border-b border-outline-variant">
  <div
    class="absolute inset-0 bg-cover bg-center scale-x-[-1] opacity-50 [filter:contrast(1.12)_saturate(1.25)_brightness(0.82)]"
    style="background-image: url('/images/about-salon-hero.png')"
  >
  </div>
  <div class="mouse-glow absolute inset-0 pointer-events-none"></div>
  <div class="absolute inset-0 bg-background/50"></div>
  <div class="absolute inset-0 bg-background/15 backdrop-blur-[2px] pointer-events-none"></div>

  <div class="relative shell py-16 md:py-24">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-12">
      <div id="ueber" class="scroll-reveal reveal-from-left lg:col-span-5">
        <SectionHeading index="04" title={about.title} />

        <p class="mt-8 max-w-xl text-body-lg text-on-surface-variant">{about.text}</p>

        <div
          class="mt-10 grid grid-cols-[minmax(7.5rem,130px)_1fr] gap-x-6 gap-y-0 text-label-caps text-on-surface-variant"
        >
          <div class="flex flex-col gap-8">
            <div class="space-y-2">
              <h3 class="mb-3 text-label-caps !text-on-surface">Inhaber</h3>
              <p>{s.owner}</p>
            </div>
            <div class="space-y-2">
              <h3 class="mb-3 text-label-caps !text-on-surface">Kontakt</h3>
              <a
                href={`tel:${s.phone}`}
                class="group/contact flex items-center gap-2 hover:text-primary transition-colors duration-150"
              >
                <PhoneIcon />
                <span class="nav-link group-hover/contact:[&::after]:scale-x-100">Telefon</span>
              </a>
              <a
                href={`mailto:${s.email}`}
                class="group/contact flex items-center gap-2 hover:text-primary transition-colors duration-150"
              >
                <MailIcon />
                <span class="nav-link group-hover/contact:[&::after]:scale-x-100">E-Mail</span>
              </a>
            </div>
          </div>

          <OpeningHours client:idle hours={about.openingHours} />
        </div>
      </div>

      <div id="barbers" class="scroll-reveal reveal-deep lg:col-span-7">
        <SectionHeading index="05" title="Barbers" />
        <div class="mt-8 divide-y divide-outline-variant">
          {
            barbers.map((barber, index) => (
              <article class="barber-card scroll-reveal group py-8 first:pt-0">
                <div
                  class:list={[
                    'flex flex-col gap-6 sm:items-stretch',
                    index % 2 === 1 ? 'sm:flex-row-reverse' : 'sm:flex-row',
                  ]}
                >
                  <div class="flex min-w-0 flex-1 flex-col justify-between">
                    <div>
                      <h3 class="text-title-md uppercase transition-colors duration-300 group-hover:text-primary">
                        {barber.name}
                      </h3>
                      {barber.position && (
                        <p class="mt-1 text-label-caps text-secondary">{barber.position}</p>
                      )}
                      {barber.about && (
                        <p class="mt-4 max-w-md text-sm leading-relaxed text-on-surface-variant">
                          {barber.about}
                        </p>
                      )}
                    </div>
                    <a
                      href="#preise"
                      class="nav-link mt-6 w-fit text-label-caps text-on-surface-variant hover:text-primary"
                    >
                      Zu den Preisen
                    </a>
                  </div>

                  <div class="barber-photo w-full overflow-hidden border border-outline-variant sm:w-[44%] sm:max-w-[280px] aspect-[4/5] transition-colors duration-500 group-hover:border-primary">
                    <img
                      src={barber.image}
                      alt={barber.name}
                      class="h-full w-full object-cover object-top transition-[transform,filter] duration-700 group-hover:scale-[1.035] group-hover:brightness-[1.04]"
                      loading="lazy"
                    />
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
