---
import { getEntry } from 'astro:content';
import InstagramIcon from './InstagramIcon.astro';
import Logo from './Logo.astro';
import ThemeSwitcher from './ThemeSwitcher.svelte';
import TikTokIcon from './TikTokIcon.astro';

const settingsEntry = await getEntry('settings', 'settings');
const s = settingsEntry!.data;
const year = new Date().getFullYear();
---

<footer
  class="site-footer border-t border-outline-variant bg-background pb-28 pt-12 md:pb-12 md:pt-14"
>
  <div class="shell flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
    <div>
      <a
        href="/"
        class="inline-flex focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
      >
        <Logo alt={`${s.name} – ${s.tagline}`} class="site-logo-footer" />
      </a>
      <div class="mt-4 text-xs text-on-surface-variant opacity-70 space-y-0.5">
        <div>{s.address}</div>
        <div>{s.zipCity}</div>
      </div>
    </div>
    <p class="text-xs tracking-widest text-on-surface-variant uppercase">
      © {year}
      {s.name}. Alle Rechte vorbehalten.
    </p>
    <div class="flex flex-wrap items-center gap-4 text-xs tracking-widest text-on-surface-variant">
      <a href="/impressum/" class="nav-link hover:text-primary">Impressum</a>
      <a href="/datenschutz/" class="nav-link hover:text-primary">Datenschutz</a>

      <div class="flex gap-3 border-l border-outline-variant pl-3 text-on-surface-variant">
        <a
          href={s.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="social-icon-link hover:text-primary"
        >
          <InstagramIcon />
        </a>
        <a
          href={s.tiktokUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok"
          class="social-icon-link hover:text-primary"
        >
          <TikTokIcon />
        </a>
      </div>

      <div class="border-l border-outline-variant pl-3">
        <ThemeSwitcher client:idle />
      </div>
    </div>
  </div>
</footer>
