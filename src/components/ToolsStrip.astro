<section class="border-b border-outline-variant bg-background" aria-label="Werkzeug">
  <div class="shell grid gap-6 py-12 md:grid-cols-2 md:gap-10 md:py-16">
    <figure>
      <div
        class="product-stage h-72 border border-outline-variant md:h-80"
        data-model="/models/scissors.glb"
        aria-hidden="true"
      >
      </div>
      <figcaption class="mt-3 text-label-caps text-on-surface-variant">Schere</figcaption>
    </figure>
    <figure>
      <div
        class="product-stage h-72 border border-outline-variant md:h-80"
        data-model="/models/clipper.glb"
        aria-hidden="true"
      >
      </div>
      <figcaption class="mt-3 text-label-caps text-on-surface-variant">
        Maschine <span class="text-primary">· Hebel & Schalter</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const stages = document.querySelectorAll<HTMLElement>('[data-model]');
  if (stages.length > 0) {
    const { mountProduct } = await import('./stage/mountProduct');
    stages.forEach((stage) => {
      const url = stage.dataset.model;
      if (url) mountProduct(stage, url);
    });
  }
</script>
